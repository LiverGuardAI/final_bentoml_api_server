FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV BENTOML_PORT=3001

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create bentoml user
RUN groupadd -g 1034 bentoml && \
    useradd -m -u 1034 -g bentoml bentoml

# Set working directory
WORKDIR /home/bentoml/bento

# Copy bento contents
COPY --chown=bentoml:bentoml . .

# Install Python dependencies with pip (not uv)
RUN pip install --no-cache-dir -r ./env/python/requirements.txt

# Switch to bentoml user
USER bentoml

# Expose port
EXPOSE 3001

# Run the service
CMD ["bentoml", "serve", ".", "--host", "0.0.0.0", "--port", "3001"]
